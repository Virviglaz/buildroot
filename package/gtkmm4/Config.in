comment "gtkmm4 needs libgtk4 and a toolchain w/ C++, wchar, threads, gcc >= 4.9, dynamic library"
	depends on BR2_USE_MMU
	depends on BR2_TOOLCHAIN_HAS_SYNC_4
	depends on !BR2_TOOLCHAIN_GCC_AT_LEAST_4_9 || !BR2_USE_WCHAR \
		|| !BR2_INSTALL_LIBSTDCPP || !BR2_PACKAGE_LIBGTK4 \
		|| !BR2_TOOLCHAIN_HAS_THREADS || \
		BR2_STATIC_LIBS

config BR2_PACKAGE_GTKMM4
	bool "gtkmm4"
	depends on BR2_TOOLCHAIN_HAS_SYNC_4 # pangomm, libgtk4 -> pango -> harfbuzz
	depends on BR2_INSTALL_LIBSTDCPP # glibmm, libpangomm -> glibmm/pango
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_4_9 # C++11
	depends on BR2_TOOLCHAIN_HAS_THREADS # *mm/libgtk3 -> libglib2
	depends on BR2_USE_MMU # *mm/libgtk4 -> libglib2
	depends on BR2_USE_WCHAR # *mm/libgtk4 -> libglib2
	depends on BR2_PACKAGE_LIBGTK4
	depends on !BR2_STATIC_LIBS # atkmm
	select BR2_PACKAGE_ATKMM
	select BR2_PACKAGE_CAIROMM
	select BR2_PACKAGE_GLIBMM
	select BR2_PACKAGE_LIBSIGC3
	select BR2_PACKAGE_PANGOMM
	help
	  The gtkmm4 package is a set of C++ bindings for GTK 4.

	  http://www.gtkmm.org/
